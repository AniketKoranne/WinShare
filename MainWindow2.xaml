<Window x:Class="WinShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WinShare – WiFi File Transfer"
        Height="680" Width="920"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <Window.Resources>
        <!-- Card style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.10" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Log item style -->
        <Style x:Key="LogItem" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Style="{StaticResource Card}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📡" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="WinShare" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="WiFi File Transfer — Send &amp; Receive" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLabel" Text="Stopped" FontWeight="SemiBold"
                               Foreground="#EF4444" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== LEFT PANEL: QR + Controls ===== -->
        <ScrollViewer Grid.Row="2" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.Row="2" Grid.Column="0" >

                <!-- QR Code Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Scan to Connect" FontWeight="SemiBold"
                       Foreground="#1E293B" FontSize="14" Margin="0,0,0,12"/>
                        <Border x:Name="QrBorder" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="8" Width="200" Height="200"
                    HorizontalAlignment="Center" Background="#F8FAFC">
                            <Grid>
                                <TextBlock x:Name="QrPlaceholder" Text="Start server&#10;to generate QR"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Foreground="#94A3B8" FontSize="13"/>
                                <Image x:Name="QrCodeImage" Stretch="Uniform" Margin="8"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="IpLabel" Text="—"
                       HorizontalAlignment="Center" Margin="0,10,0,0"
                       FontSize="12" Foreground="#3B82F6" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button x:Name="CopyUrlBtn" Content="📋  Copy URL"
                    Style="{StaticResource BtnSecondary}"
                    Margin="0,8,0,0" Click="CopyUrl_Click"
                    IsEnabled="False" Height="34" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Server Controls Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Server" FontWeight="SemiBold"
                       Foreground="#1E293B" FontSize="14" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Port" VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="PortBox" Grid.Column="2" Text="8080"
                         FontSize="13" Height="32" Padding="8,4"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1" BorderThickness="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="White" CornerRadius="6"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartBtn" Content="▶  Start"
                        Style="{StaticResource BtnPrimary}"
                        Click="StartServer_Click"/>
                            <Button x:Name="StopBtn" Grid.Column="2" Content="■  Stop"
                        Style="{StaticResource BtnDanger}"
                        Click="StopServer_Click" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Send Files Card -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Send to Phone" FontWeight="SemiBold"
                       Foreground="#1E293B" FontSize="14" Margin="0,0,0,12"/>
                        <Button x:Name="AddFilesBtn" Content="➕  Add Files to Share"
                    Style="{StaticResource BtnSecondary}"
                    Click="AddFiles_Click" IsEnabled="False"/>
                        <ListBox x:Name="SharedFilesList" Margin="0,8,0,0"
                     Height="100" BorderBrush="#E2E8F0" BorderThickness="1"
                     Background="#F8FAFC" FontSize="11" Foreground="#475569">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                        <ScrollViewer Padding="4">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                        <Button x:Name="ClearFilesBtn" Content="🗑  Clear List"
                    Style="{StaticResource BtnPrimary}"
                    Background="#94A3B8"
                    Margin="0,6,0,0" Height="30" FontSize="11"
                    Click="ClearFiles_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        

        <!-- ===== RIGHT PANEL: Activity Log ===== -->
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- Transfer Log -->
            <Border Style="{StaticResource Card}" Grid.Row="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Transfer Activity" FontWeight="SemiBold"
                                   Foreground="#1E293B" FontSize="14" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Clear Log"
                                Style="{StaticResource BtnPrimary}"
                                Background="#94A3B8"
                                Height="28" FontSize="11" Click="ClearLog_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  x:Name="LogScrollViewer">
                        <StackPanel x:Name="LogPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Stats Bar -->
            <Border Style="{StaticResource Card}" Grid.Row="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Session Stats" FontWeight="SemiBold"
                               Foreground="#1E293B" FontSize="14" Margin="0,0,0,12"/>
                    <UniformGrid Grid.Row="1" Columns="3" Rows="1">
                        <!-- Received -->
                        <Border Background="#EFF6FF" CornerRadius="8" Margin="0,0,8,0" Padding="14,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📥 Received" FontSize="11" Foreground="#3B82F6"
                                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ReceivedCount" Text="0 files"
                                           FontSize="20" FontWeight="Bold" Foreground="#1D4ED8"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Sent -->
                        <Border Background="#F0FDF4" CornerRadius="8" Margin="0,0,8,0" Padding="14,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📤 Sent" FontSize="11" Foreground="#10B981"
                                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SentCount" Text="0 files"
                                           FontSize="20" FontWeight="Bold" Foreground="#059669"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Save Path -->
                        <Border Background="#FFF7ED" CornerRadius="8" Padding="14,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📁 Save Path" FontSize="11" Foreground="#F59E0B"
                                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SavePathLabel" Text="Desktop"
                                           FontSize="12" FontWeight="Bold" Foreground="#D97706"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
